#!/bin/sh
# rubber-ducky binary bootstrap wrapper.
#
# Claude Code installs this plugin as plain files — no npm, no postinstall,
# and users need neither Node nor Bun. The real CLI is a compiled per-platform
# binary attached to GitHub Releases (see docs/adr/plugin-binary-bootstrap.md).
# This wrapper resolves the platform, downloads the binary matching the
# plugin's version once, caches it OUTSIDE the plugin directory (plugin dirs
# are wiped and re-copied on every update), then execs it with all arguments
# passed through untouched.
#
# The cache is keyed by version: ~/.cache/rubber-ducky/<version>/rubber-ducky.
# When the plugin updates, the versioned path no longer exists, so the wrapper
# re-fetches and prunes the stale versions — cached binary and plugin version
# can never silently diverge.
#
# Environment overrides:
#   RUBBER_DUCKY_CACHE_DIR       cache root (default: $XDG_CACHE_HOME/rubber-ducky,
#                                falling back to ~/.cache/rubber-ducky)
#   RUBBER_DUCKY_DOWNLOAD_BASE   release download base URL (default: this repo's
#                                GitHub Releases). Tests point this at a local
#                                server; the URL layout below stays identical.
#   RUBBER_DUCKY_BOOTSTRAP_ONLY  "1" = ensure the binary is cached, then exit 0
#                                without running it (used by the pre-warm hook).

set -eu

fail() {
  printf 'rubber-ducky: %s\n' "$1" >&2
  exit 1
}

PLUGIN_ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
MANIFEST="$PLUGIN_ROOT/.claude-plugin/plugin.json"
[ -f "$MANIFEST" ] || fail "plugin manifest not found at $MANIFEST"

# Extract "version" from plugin.json. POSIX sed, no jq/node dependency; the
# manifest is small and has exactly one "version" key.
VERSION=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$MANIFEST" | head -n 1)
[ -n "$VERSION" ] || fail "could not read version from $MANIFEST"

# The scraped version feeds cache paths and the download URL. Reject anything
# outside a strict allowlist so a tampered manifest can't smuggle path
# traversal ("../"), URL path segments ("/"), or whitespace into either.
case "$VERSION" in
  *[!0-9A-Za-z.-]*) fail "invalid version in $MANIFEST: $VERSION (allowed: letters, digits, '.', '-')" ;;
esac

# Map uname to the release asset suffix (must match .github/workflows/release.yml).
os=$(uname -s)
arch=$(uname -m)
case "$os" in
  Linux)
    case "$arch" in
      x86_64 | amd64) PLATFORM=linux-x64 ;;
      *) fail "unsupported platform: $os $arch (supported: Linux x86_64, macOS x86_64/arm64)" ;;
    esac
    ;;
  Darwin)
    case "$arch" in
      arm64) PLATFORM=darwin-arm64 ;;
      x86_64) PLATFORM=darwin-x64 ;;
      *) fail "unsupported platform: $os $arch (supported: Linux x86_64, macOS x86_64/arm64)" ;;
    esac
    ;;
  *)
    fail "unsupported platform: $os $arch (supported: Linux x86_64, macOS x86_64/arm64)"
    ;;
esac

CACHE_ROOT=${RUBBER_DUCKY_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/rubber-ducky}
BINARY="$CACHE_ROOT/$VERSION/rubber-ducky"

# Self-heal a poisoned cache. A middlebox (corporate TLS-inspection proxy,
# captive portal) can answer the download with a 200 whose body is an HTML
# block page; exec'ing that runs it as a shell script and fails with a blocking
# error through the PreToolUse hook. A compiled binary starts with a non-text
# magic byte (ELF/Mach-O); an HTML page starts with '<'. If the cached file
# looks like HTML, drop it so the block below re-fetches. (Any other bad body
# is caught at download time by the --version check below.)
if [ -e "$BINARY" ]; then
  first=$(head -c 1 "$BINARY" 2>/dev/null || true)
  case "$first" in
    '<') rm -f "$BINARY" ;;
  esac
fi

if [ ! -x "$BINARY" ]; then
  BASE=${RUBBER_DUCKY_DOWNLOAD_BASE:-https://github.com/brandtam/rubber-ducky/releases/download}
  URL="$BASE/v$VERSION/rubber-ducky-$PLATFORM"

  # Release assets on GitHub are mutable; the only integrity anchor that
  # travels with the plugin through git is .claude-plugin/checksums.json,
  # committed by the release workflow. Resolve it relative to this script's
  # own plugin root (never PATH or cwd), and refuse to download at all when
  # the entry for this version+platform is missing — fail closed, not open.
  CHECKSUMS="$PLUGIN_ROOT/.claude-plugin/checksums.json"
  [ -f "$CHECKSUMS" ] || fail "checksums file not found at $CHECKSUMS — refusing to download an unverifiable binary"
  EXPECTED=$(sed -n 's|.*"v'"$VERSION/$PLATFORM"'"[[:space:]]*:[[:space:]]*"\([0-9a-fA-F]\{64\}\)".*|\1|p' "$CHECKSUMS" | head -n 1)
  [ -n "$EXPECTED" ] || fail "no checksum entry for v$VERSION/$PLATFORM in $CHECKSUMS — refusing to download an unverifiable binary"

  # Pick the sha256 tool up front so a machine with neither fails before
  # spending bandwidth on a download it can't verify.
  if command -v sha256sum >/dev/null 2>&1; then
    SHA_CMD="sha256sum"
  elif command -v shasum >/dev/null 2>&1; then
    SHA_CMD="shasum -a 256"
  else
    fail "neither sha256sum nor shasum is available to verify the download"
  fi

  mkdir -p "$CACHE_ROOT/$VERSION"

  # Sweep partials left by an earlier download that was killed before mv (e.g.
  # the PreToolUse hook hitting its timeout mid-fetch). Nothing else prunes
  # them until the version bumps, so they otherwise accumulate.
  rm -f "$CACHE_ROOT/$VERSION"/.download.* 2>/dev/null || true

  # Download to a temp file, then atomically mv into place — a concurrent
  # invocation (e.g. pre-warm racing a real call) never sees a half-written
  # binary; worst case both download and the last mv wins with identical bytes.
  TMP=$(mktemp "$CACHE_ROOT/$VERSION/.download.XXXXXX") || fail "could not create temp file in $CACHE_ROOT/$VERSION"
  # Clean the partial if we're interrupted or killed mid-download.
  trap 'rm -f "$TMP"' INT TERM
  # Timeouts so an unreachable or blackholed network fails fast with the clear
  # message below, instead of stalling every Bash tool call for the full hook
  # timeout (or hanging an interactive invocation indefinitely).
  # Never allow a redirect to step down from HTTPS. For curl, when the URL
  # itself is HTTPS (the production default) also forbid any non-HTTPS
  # initial protocol; redirects are pinned to HTTPS unconditionally. The
  # plain-HTTP branch exists only for RUBBER_DUCKY_DOWNLOAD_BASE overrides
  # (hermetic tests on a loopback server).
  case "$URL" in
    https://*) CURL_PROTO_OPTS="--proto =https --proto-redir =https" ;;
    *) CURL_PROTO_OPTS="--proto-redir =https" ;;
  esac
  if command -v curl >/dev/null 2>&1; then
    # $CURL_PROTO_OPTS intentionally unquoted: it expands to whole flags.
    curl -fsSL $CURL_PROTO_OPTS --connect-timeout 10 --max-time 600 -o "$TMP" "$URL" || {
      rm -f "$TMP"
      fail "download failed: $URL"
    }
  elif command -v wget >/dev/null 2>&1; then
    # wget has no --proto-redir equivalent. --https-only (GNU wget >= 1.17)
    # rejects any non-HTTPS URL including redirect targets; use it whenever
    # the build supports it and the URL is HTTPS. On older/busybox wget the
    # flag is absent — the sha256 check below still catches a tampered body,
    # so downgrade-redirect exposure is integrity-covered even there.
    WGET_HTTPS_OPT=""
    case "$URL" in
      https://*)
        if wget --help 2>&1 | grep -q -- --https-only; then
          WGET_HTTPS_OPT="--https-only"
        fi
        ;;
    esac
    wget -q $WGET_HTTPS_OPT --timeout=10 --tries=2 -O "$TMP" "$URL" || {
      rm -f "$TMP"
      fail "download failed: $URL"
    }
  else
    rm -f "$TMP"
    fail "neither curl nor wget is available to download $URL"
  fi

  # Integrity gate: the downloaded bytes must hash to the git-pinned value
  # BEFORE anything executes them (the --version probe below) and before they
  # land in the cache. A swapped release asset dies here with no code run.
  ACTUAL=$($SHA_CMD "$TMP") || { rm -f "$TMP"; fail "could not hash downloaded file"; }
  ACTUAL=${ACTUAL%% *}
  if [ "$ACTUAL" != "$EXPECTED" ]; then
    rm -f "$TMP"
    fail "checksum mismatch for $URL
  expected sha256: $EXPECTED
  actual sha256:   $ACTUAL
The release asset does not match the checksum shipped with the plugin. Refusing to run it."
  fi

  chmod 755 "$TMP"
  # Runnability probe (only after the hash matched). curl -f / wget reject
  # non-2xx, but a 200 with a truncated transfer passes them — running
  # --version catches it, so a bad body fails loudly here instead of being
  # cached and exec'd on every later call.
  if ! "$TMP" --version >/dev/null 2>&1; then
    rm -f "$TMP"
    fail "downloaded file is not a runnable rubber-ducky binary (blocked URL or corrupt download?): $URL"
  fi
  mv -f "$TMP" "$BINARY"
  trap - INT TERM

  # Prune binaries from other versions — the cache holds exactly the version
  # the installed plugin needs, so upgrades don't accumulate stale binaries.
  for dir in "$CACHE_ROOT"/*/; do
    [ -d "$dir" ] || continue
    case "$dir" in
      "$CACHE_ROOT/$VERSION/") ;;
      *) rm -rf "$dir" ;;
    esac
  done
fi

if [ "${RUBBER_DUCKY_BOOTSTRAP_ONLY:-}" = "1" ]; then
  exit 0
fi

# The cached binary is NOT re-hashed at exec time — it was verified at
# download, and the cache lives under the user's own $HOME with user-only
# write access; re-hashing a ~50 MB binary on every invocation (including
# every PreToolUse hook fire) would add noticeable latency for a threat
# (attacker with local write access to $HOME) that already implies full
# compromise. See docs/adr/plugin-binary-bootstrap.md.
exec "$BINARY" "$@"
